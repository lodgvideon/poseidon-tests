# Compiled binaries. The Dockerfile builds both cmd/ binaries itself, and
# scripts/build-and-load.sh never uses a host build, so nothing here needs
# checking in — and a host build is platform-specific (a Windows .exe is
# useless in the distroless Linux image).
bin/
*.exe
*.exe~
*~

# pprof output from `driver -profile-dir`.
prof/
prof*/
*.pprof
*.prof

# Agent/session scratch that lands in the repo root.
.claude/

# Run output. scripts/run.sh defaults to OUTDIR=results, so a local matrix run
# lands directly in results/ — that is someone's machine's numbers, not the
# repo's. results/replicated/ is the one committed dataset and is negated below.
#
# The two-line form is required: git does not descend into an excluded
# directory, so a bare `results/` followed by `!results/replicated/` would
# silently keep ignoring it.
/results/*
!/results/replicated/

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Python
__pycache__/
*.pyc
